# Copiar a .env; valores test son credenciales ficticias para el emulador.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
GROUP_ID=grupo01
QUEUE_PREFIX=fenix-grupo01
PROJECT=fenix
WEBHOOK_SECRET=
# Completar el token y el chat para habilitar avisos por Telegram.
NOTIFY_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
# Obtener el ID con getUpdates; pasos en README.md, sección 13.
TELEGRAM_CHAT_ID=
# Slack no está implementado en esta entrega.
SLACK_WEBHOOK_URL=
# Completar con el token de cuenta de LocalStack entregado para la cátedra.
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_IMAGE=localstack/localstack:2026.10.0
